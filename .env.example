# Copy to .env for local dev (used by `netlify dev`).
# In production this is set in the Netlify dashboard, NOT committed.
# Get a key at https://www.last.fm/api/account/create — read methods
# (artist.getSimilar / artist.search) need only this key, no OAuth/callback.
LASTFM_API_KEY=your_lastfm_api_key_here

# Spotify — for the artist players + images (bio still comes from Last.fm).
# Register an app at https://developer.spotify.com/dashboard, copy the Client ID
# and Client Secret. Client Credentials flow — no redirect URI / user login needed.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
